{
  "name": "sano-local-tts",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.mjs",
